# Copy to .env and replace all values before deployment. Do not commit .env.
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
SEATUNNEL_IMAGE=data-sync-poc/seatunnel:2.3.13
CADDY_IMAGE=caddy:2.8.4-alpine
MYSQL_ROOT_PASSWORD=change-this-mysql-password
MYSQL_DATABASE=ry-vue
REDIS_PASSWORD=change-this-redis-password
MYSQL_PORT=13316
REDIS_PORT=16389
SEATUNNEL_PORT=18084
WEB_PORT=18083
BACKEND_PORT=18082
SYNC_CREDENTIAL_ENCRYPTION_ENABLED=true
SYNC_CREDENTIAL_ENCRYPTION_PASSWORD=
