# 数据同步平台 - 部署配置
# 复制为 .env 后按说明填写：cp .env.example .env && chmod 600 .env
# 取值不要加引号，不要含空格、$、`、\、'、"。口令建议 12 位以上的字母、数字和 @#%+=_-. 组合。
# .env 含全部口令与凭证主密钥：只保存在部署机上，并与备份分开妥善保管。

# ---------- 版本与目录 ----------
# 镜像版本（随安装包给出，不要手工修改）
DS_VERSION=1.0.0
# Compose 项目名：容器名以它为前缀
COMPOSE_PROJECT_NAME=data-sync
# 数据目录（元数据库、Redis、引擎 checkpoint、日志）。用绝对路径，升级换安装目录时数据不动。
DATA_DIR=/data/data-sync
# 时区
TZ=Asia/Shanghai

# ---------- 访问入口 ----------
# Web 绑定地址与 HTTP 端口
WEB_BIND=0.0.0.0
WEB_HTTP_PORT=80
# 启用 HTTPS：true 时需要 certs/server.crt 与 certs/server.key，HTTP 端口自动跳转
ENABLE_HTTPS=false
WEB_HTTPS_PORT=443

# ---------- 元数据库 ----------
# bundled-db = 使用随包 MySQL（默认）。改用已有 MySQL 8：清空此项，并设置下面的 DB_HOST / DB_PORT
COMPOSE_PROFILES=bundled-db
# 随包 MySQL 固定为 datasync-mysql
DB_HOST=datasync-mysql
DB_PORT=3306
DB_NAME=ry-vue
# 平台专用账号（只对 DB_NAME 有权限）
DB_USER=datasync
DB_PASSWORD=
# 随包 MySQL 的 root 口令（备份、排障用；使用已有 MySQL 时留空）
MYSQL_ROOT_PASSWORD=

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- 安全 ----------
# 数据源口令加密主密钥：恰好 16、24 或 32 个字符（推荐 32）。安装后不能更改，丢失即无法解密已保存的数据源口令。
CREDENTIAL_KEY=
# 管理员 admin 的初始口令（8~20 位）。首次安装时生效，之后在页面「个人中心」修改。
ADMIN_INITIAL_PASSWORD=

# ---------- 资源 ----------
# 后端 JVM 堆
BACKEND_HEAP=2g
# 引擎 JVM 堆：按同时运行的表数估算，每张 CDC 表约 200~300 MB，最少 2g
ENGINE_HEAP=4g

# ---------- 同步参数 ----------
# Kafka 单条记录上限（字节）：引擎写 raw topic 与桥接发布共用，默认 16 MiB
KAFKA_MAX_RECORD_BYTES=16777216
# 平台日志级别（info / warn / debug）
LOG_LEVEL=info
