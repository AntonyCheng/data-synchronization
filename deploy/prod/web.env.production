# 生产前端构建环境（build-prod-package.ps1 复制为前端目录的 .env.production）。
# 请求经 Caddy 的 /prod-api/ 转发到后端；客户端 ID 是 ry_vue.sql 预置的 PC 端。
VITE_APP_TITLE=一站式实时计算平台
VITE_APP_LOGO_TITLE=一站式实时计算平台
VITE_APP_ENV=production
VITE_APP_BASE_API=/prod-api
VITE_APP_CONTEXT_PATH=/
VITE_APP_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e
VITE_APP_MESSAGE_ENABLED=true
VITE_APP_MESSAGE_TRANSPORT=sse
VITE_APP_MESSAGE_PATH=/resource/message
VITE_APP_ENCRYPT=false
VITE_APP_RSA_PUBLIC_KEY=
VITE_APP_RSA_PRIVATE_KEY=
VITE_APP_MONITOR_ADMIN=
VITE_APP_SNAILJOB_ADMIN=
