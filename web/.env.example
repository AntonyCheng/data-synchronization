# Template for web/.env.development (which is gitignored).
# `dev.ps1 up` copies this file to .env.development on first run if it is missing.
# The values below are the correct defaults for local development against dev.ps1.
VITE_APP_TITLE=一站式实时计算平台
VITE_APP_LOGO_TITLE=一站式实时计算平台
VITE_APP_ENV=development
VITE_APP_BASE_API=/dev-api
VITE_APP_CONTEXT_PATH=/
VITE_APP_PORT=8003
# Backend from dev.ps1 listens on 18081; /dev-api is proxied here.
VITE_APP_API_TARGET=http://localhost:18081
# Default RuoYi sys_client PC client id, seeded by server/script/sql/ry_vue.sql.
VITE_APP_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e
VITE_APP_MESSAGE_ENABLED=true
VITE_APP_MESSAGE_TRANSPORT=sse
VITE_APP_MESSAGE_PATH=/resource/message
# Keep disabled until a local RSA key pair is configured.
VITE_APP_ENCRYPT=false
VITE_APP_RSA_PUBLIC_KEY=
VITE_APP_RSA_PRIVATE_KEY=
VITE_APP_MONITOR_ADMIN=http://localhost:9090/admin/applications
VITE_APP_SNAILJOB_ADMIN=http://localhost:8800/snail-job
